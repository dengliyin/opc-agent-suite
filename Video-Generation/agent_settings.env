# Shared non-secret API and model settings. Commit changes to Git.
OTU_BASE_URL=https://zexapi.com
GROK_BASE_URL=https://www.runninghub.cn

IMAGE_MODEL=gpt-image-2-4K
IMAGE_FALLBACK_MODELS=
OMNI_MODEL=omni_flash-10s
IMAGE_SIZE=2160x3840
VIDEO_SIZE=720x1280
OVERWRITE=false

OMNI_CHARACTER_API_MODEL=otu:image2
OMNI_CHARACTER_IMAGE_SIZE=720x1280
OMNI_STORYBOARD_API_MODEL=otu:image2
OMNI_STORYBOARD_IMAGE_SIZE=720x1280
OMNI_VIDEO_API_MODEL=otu:omni_flash-10s
OMNI_FUNCTION_VIDEO_SIZE=720x1280
OMNI_FUNCTION_VIDEO_ASPECT_RATIO=9:16
OMNI_FUNCTION_VIDEO_RESOLUTION=720p
OMNI_FUNCTION_VIDEO_DURATION=10

GROK_CHARACTER_API_MODEL=grok:G-2.0
GROK_CHARACTER_IMAGE_ASPECT_RATIO=9:16
GROK_CHARACTER_IMAGE_RESOLUTION=4k
GROK_STORYBOARD_API_MODEL=grok:G-2.0
GROK_STORYBOARD_IMAGE_ASPECT_RATIO=9:16
GROK_STORYBOARD_IMAGE_RESOLUTION=4k
GROK_VIDEO_API_MODEL=grok:X v1.5
GROK_FUNCTION_VIDEO_ASPECT_RATIO=9:16
GROK_FUNCTION_VIDEO_RESOLUTION=720p
GROK_FUNCTION_VIDEO_DURATION=10

IMAGE_RETRY_ATTEMPTS=3
IMAGE_RETRY_BASE_SECONDS=10
IMAGE_POLL_INTERVAL_SECONDS=5
IMAGE_TIMEOUT_SECONDS=1200
IMAGE_REFERENCE_MAX_SIDE=2048
IMAGE_REFERENCE_JPEG_QUALITY=88
OMNI_POLL_INTERVAL_SECONDS=5
OMNI_TIMEOUT_SECONDS=1200
OMNI_RETRY_ATTEMPTS=3
OMNI_UPSTREAM_RETRY_ATTEMPTS=3
OMNI_RETRY_BASE_SECONDS=10
GROK_POLL_INTERVAL_SECONDS=5
GROK_TIMEOUT_SECONDS=1200
GROK_RETRY_ATTEMPTS=3
GROK_RETRY_BASE_SECONDS=10

# Copy this file to .env. Keep .env local and never commit it.
OPC_VAULT_ROOT="/path/to/Obsidian Vault"

# Unified console and agent URLs.
KESAI_APP_HOST="127.0.0.1"
KESAI_APP_PORT="8888"
OPC_HOT_VIDEO_AGENT_URL="http://127.0.0.1:9991/"
OPC_VIDEO_TEARDOWN_AGENT_URL="http://127.0.0.1:9992/"
OPC_SCRIPT_PRODUCTION_AGENT_URL="http://127.0.0.1:9993/"
OPC_SCRIPT_ADAPTATION_AGENT_URL="http://127.0.0.1:9994/"
OPC_VIDEO_OUTPUT_AGENT_URL="http://127.0.0.1:9995/"
OPC_FINISHED_VIDEO_MANAGER_URL="http://127.0.0.1:9996/"
OPC_PRODUCT_SCRIPT_REWRITE_URL="http://127.0.0.1:9997/"
OPC_VIDEO_ASSEMBLY_AGENT_URL="http://127.0.0.1:9998/"
OPC_HYBRID_SCRIPT_ADAPTATION_AGENT_URL="http://127.0.0.1:9999/"
OPC_HYBRID_VIDEO_MIXER_AGENT_URL="http://127.0.0.1:10000/"
OPC_HYBRID_VIDEO_COLLECTION_AGENT_URL="http://127.0.0.1:10001/"
OPC_HYBRID_SCRIPT_ANALYSIS_AGENT_URL="http://127.0.0.1:10002/"
OPC_HYBRID_SCRIPT_GENERATION_AGENT_URL="http://127.0.0.1:10003/"
OPC_HYBRID_AUDIO_GENERATION_AGENT_URL="http://127.0.0.1:10004/"
OPC_AUTO_PUBLISH_PIPELINE_URL="http://127.0.0.1:10005/"

# Shared Vault paths. Child agents inherit these values from the console.
VIDEO_TEARDOWN_INPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/01来源素材"
VIDEO_TEARDOWN_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/02参考脚本"
PRODUCT_SCRIPT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/03产品脚本"
HYBRID_VIDEO_TEARDOWN_INPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/01参考视频"
HYBRID_VIDEO_TEARDOWN_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/02解析脚本"
HYBRID_SCRIPT_GENERATION_INPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/02解析脚本"
HYBRID_SCRIPT_GENERATION_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/03复刻裂变脚本"
HYBRID_OMNI_SCRIPT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/04适配脚本/omni"
HYBRID_AI_CLIP_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/05AI片段"
HYBRID_OMNI_VIDEO_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/05AI片段/omni"
HYBRID_AUDIO_COPY_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/06音频文案"
HYBRID_PRODUCT_AUDIO_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/06音频文件"
HYBRID_REAL_FOOTAGE_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/07实拍素材"
HYBRID_MIX_WORK_ROOT="${OPC_VAULT_ROOT}/wiki/视频/AI实拍混剪/08混剪工作区"
SCRIPT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/04适配脚本/omni"
GROK_SCRIPT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/04适配脚本/grok"
REFERENCE_ROOT="${OPC_VAULT_ROOT}/wiki/产品/产品底图"
VIDEO_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/05AI片段/omni"
GROK_VIDEO_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/05AI片段/grok"
VIDEO_ASSEMBLY_PENDING_ROOT="${OPC_VAULT_ROOT}/wiki/视频/纯AI视频/06合成工作区"
VIDEO_ASSEMBLY_OUTPUT_ROOT="${OPC_VAULT_ROOT}/wiki/视频/成品视频"
VIDEO_TITLE_LIBRARY_ROOT="${OPC_VAULT_ROOT}/wiki/视频/成品视频/视频标题库"
SCRIPT_MISTAKE_BOOK_ROOT="${OPC_VAULT_ROOT}/wiki/视频/共享知识库/脚本错题本"

# Local credentials. Leave blank in the template.
FASTMOSS_PHONE=""
FASTMOSS_PASSWORD=""
MODELMESH_API_KEY=""
VIDEO_TEARDOWN_AGENT_API_KEY=""
DEEPSEEK_API_KEY=""
OTU_API_KEY=""
GROK_API_KEY=""

# Optional installation overrides.
# New installations only: create the empty default input/output directory layout.
OPC_INITIALIZE_STORAGE_LAYOUT="1"

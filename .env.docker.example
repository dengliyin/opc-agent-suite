# The first Docker startup copies this template to .env and replaces the three
# storage roots with paths beside the repository, on the same disk.
# Existing .env files are never overwritten.
OPC_VAULT_ROOT="/absolute/path/to/Obsidian Vault"
OPC_DOCKER_DATA_ROOT="/absolute/path/to/OPC-Data/docker"
VIDEO_ASSEMBLY_WORK_ROOT="/absolute/path/to/OPC-Data/Video-Assembly-hd"

# Bind only to this machine by default. Use 0.0.0.0 only behind a firewall/reverse proxy.
OPC_DOCKER_BIND="127.0.0.1"
# Browser links shown by the console. For remote access, set the server IP or domain.
OPC_PUBLIC_HOST="localhost"

# BitBrowser runs on the host. Docker Desktop resolves this name automatically;
# native Linux Docker uses the host-gateway mapping declared in docker-compose.yml.
BITBROWSER_API_URL="http://host.docker.internal:54345"

FASTMOSS_PHONE=""
FASTMOSS_PASSWORD=""
# Global AI settings managed by the 8888 console. Agent pages may only override
# these values for the lifetime of the current Agent process.
OPC_VIDEO_ANALYSIS_API_BASE_URL="https://zexapi.com"
OPC_VIDEO_ANALYSIS_MODEL="gemini-3.5-flash"
OPC_VIDEO_ANALYSIS_API_KEY=""
OPC_TEXT_API_BASE_URL="https://api.deepseek.com"
OPC_TEXT_MODEL="deepseek-v4-pro"
OPC_TEXT_API_KEY=""
OTU_BASE_URL="https://zexapi.com"
IMAGE_MODEL="gpt-image-2-4K"
OMNI_MODEL="omni_flash-10s"
OTU_API_KEY=""
GROK_BASE_URL="https://www.runninghub.cn"
GROK_IMAGE_MODEL="G-2.0"
GROK_VIDEO_MODEL="X v1.5"
GROK_API_KEY=""

# Legacy keys remain supported as migration fallbacks.
MODELMESH_API_KEY=""
VIDEO_TEARDOWN_AGENT_API_KEY=""
DEEPSEEK_API_KEY=""
